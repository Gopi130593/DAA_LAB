import time

# Number of items
n = int(input("Enter the number of items: "))

weights = []
values = []

# Input weights
print("\nEnter the weights of the items:")
for i in range(n):
    weights.append(int(input("Weight of item " + str(i + 1) + ": ")))

# Input values
print("\nEnter the values of the items:")
for i in range(n):
    values.append(int(input("Value of item " + str(i + 1) + ": ")))

# Knapsack capacity
capacity = int(input("\nEnter the maximum capacity of the knapsack: "))

# Start execution time
start_time = time.perf_counter()

# Create DP table
dp = [[0] * (capacity + 1) for _ in range(n + 1)]

# Dynamic Programming
for i in range(1, n + 1):
    for w in range(capacity + 1):

        if weights[i - 1] <= w:
            include = values[i - 1] + dp[i - 1][w - weights[i - 1]]
            exclude = dp[i - 1][w]

            dp[i][w] = max(include, exclude)

        else:
            dp[i][w] = dp[i - 1][w]

# Maximum value
max_value = dp[n][capacity]

# Find selected items
selected_items = []
w = capacity

for i in range(n, 0, -1):
    if dp[i][w] != dp[i - 1][w]:
        selected_items.append(i)
        w = w - weights[i - 1]

# End execution time
end_time = time.perf_counter()

execution_time = end_time - start_time

# Display result
print("\n----- Knapsack Result -----")
print("Maximum value:", max_value)

print("Selected items:", end=" ")
for item in reversed(selected_items):
    print(item, end=" ")

print()
print("Execution time: {:.8f} seconds".format(execution_time))

# Complexity
print("Time Complexity: O(n * W)")
print("Space Complexity: O(n * W)")
